{
  "version": 1,
  "source": "RFC-0007 Appendix C.1 and C.4.1; slice 1 shipped the signal tables and the forbidden list; slice 1G fills gh_read_allowlist and policy_set and adds consent_groups, agent_permission_denies, agent_permission_exempt, agent_mcp_denies and gh_notes; slice 2a fills isolation_vars and adds gate_rules, plugin defaults, consent_groups[].rev and per-class group/hint",
  "reserved": [],
  "agent_signals": ["CARTER_AGENT_SHELL", "AGENT", "AI_AGENT", "OPENCODE", "OPENCODE_SESSION_ID"],
  "human_signals": ["CARTER_HUMAN_SHELL"],
  "isolation_markers": [{"name": "GIT_SSH_COMMAND", "match": "contains", "value": "IdentityAgent=none"}, {"name": "DBUS_SESSION_BUS_ADDRESS", "match": "equals", "value": "unix:path=/nonexistent"}, {"name": "GH_CONFIG_DIR", "match": "equals", "value": "<home>/.carter/run/gh-empty"}, {"name": "GIT_CONFIG_KEY_n/GIT_CONFIG_VALUE_n", "match": "pair-equals-isolation-entry", "value": "an entry Carter's isolation block sets, e.g. the value no_push or a gpg.*program set to the resolved false"}],
  "pollution_set": {"by_name": ["CARTER_AGENT_SHELL", "AGENT", "AI_AGENT", "OPENCODE", "OPENCODE_SESSION_ID", "CARTER_HUMAN_SHELL"], "by_value": ["GIT_SSH_COMMAND", "DBUS_SESSION_BUS_ADDRESS", "GH_CONFIG_DIR", "GIT_CONFIG_KEY_n/GIT_CONFIG_VALUE_n"]},
  "not_pollution": ["SSH_AUTH_SOCK", "DBUS_SESSION_BUS_ADDRESS", "GH_CONFIG_DIR"],
  "warn_only": ["GH_TOKEN", "GITHUB_TOKEN"],
  "isolation_vars": ["DBUS_SESSION_BUS_ADDRESS", "GH_CONFIG_DIR", "GH_NO_UPDATE_NOTIFIER", "GH_TOKEN", "GITHUB_TOKEN", "GIT_ASKPASS", "GIT_CONFIG_COUNT", "GIT_CONFIG_PARAMETERS", "GIT_SSH_COMMAND", "GIT_TERMINAL_PROMPT", "SSH_ASKPASS_REQUIRE", "SSH_AUTH_SOCK"],
  "forbidden": [
    {"id": "commit-flags", "class": "Commit-creating verbs", "group": "g2", "applies_from": "1", "verbs": ["commit", "merge", "rebase", "cherry-pick", "revert", "am", "pull"], "items": ["--no-verify", "-n", "--no-gpg-sign", "-S", "--gpg-sign", "-S<arg>", "--gpg-sign=<arg>", "-s", "--signoff", "--reset-author", "--author"], "note": "`-n` is forbidden for `commit` only (it means `--no-verify` there; `merge -n` is `--no-stat`). Bare `-S` is not used before signing arrives (slice 2b).", "scoped_flags": [{"flag": "-n", "verbs": ["commit"], "means": "--no-verify"}], "literals": ["--no-verify", "git commit -n", "--no-gpg-sign", "git commit -S", "--gpg-sign", "--signoff", "--reset-author", "--author"], "rfc": "C.4.1 row 1", "hint": "Commit with plain `git commit -m <message>`: no `--no-verify`, signing, sign-off or author flags (Carter sets the identity)."},
    {"id": "staging", "class": "Staging", "group": "g2", "applies_from": "1", "items": ["git add -A", "git add .", "git commit -a"], "literals": ["git add -A", "git add .", "git commit -a"], "rfc": "C.4.1 row 2", "hint": "Stage explicit paths: `git add <path>...`, never everything at once."},
    {"id": "push-verbs", "class": "Push verbs", "group": "g2", "applies_from": "1G", "items": ["git push", "git send-pack"], "literals": ["git push", "git send-pack"], "rfc": "C.4.1 row 3", "hint": "There is no push from an agent shell. Write the handoff file and ask the human to run `carter push`, then `carter pr`, in their own terminal."},
    {"id": "env-overrides", "class": "Env prefixes, assignments and unsets", "group": "g2", "applies_from": "1", "via": ["VAR=", "env", "env -u", "unset", "export"], "items": ["GIT_AUTHOR_*", "GIT_COMMITTER_*", "GIT_CONFIG*", "GIT_SSH*", "GIT_ASKPASS", "GIT_EXEC_PATH", "GIT_DIR", "HOME", "XDG_CONFIG_HOME", "CARTER_*", "AGENT", "OPENCODE*"], "note": "Forbidden as a `VAR=` prefix, with `env`/`env -u`, `unset` and `export`.", "literals": ["GIT_AUTHOR_", "GIT_COMMITTER_", "GIT_CONFIG", "GIT_SSH", "GIT_ASKPASS", "GIT_EXEC_PATH", "GIT_DIR"], "rfc": "C.4.1 row 4", "hint": "Do not set, export or unset identity, git config, SSH, HOME or Carter variables on a command."},
    {"id": "git-config-writes", "class": "git config", "group": "g2", "applies_from": "1", "items": ["git config --global", "git config --system", "git config --file", "git config --worktree", "git config <key> <value>"], "note": "Any write at any scope is forbidden; only `--get*`, `--list` and `--show-*` pass.", "literals": ["git config --global", "git config --system", "git config --file", "git config --worktree", "git config user."], "rfc": "C.4.1 row 5", "hint": "Reading git config is fine (`git config --get <key>`); writing it is human-only."},
    {"id": "config-flags", "class": "-c and --config-env=", "group": "g2", "applies_from": "1", "items": ["hook.*", "core.hooksPath", "core.sshCommand", "core.askPass", "core.fsmonitor", "commit.gpgsign", "user.*", "gpg.*", "alias.*", "include*", "credential.*", "url.*", "remote.*", "http.*", "protocol.*", "carter.*"], "literals": ["-c user.", "-c gpg.", "-c commit.gpgsign", "-c core.hooksPath", "-c core.sshCommand", "-c carter.", "--config-env"], "rfc": "C.4.1 row 6", "hint": "Do not pass `-c` or `--config-env` for hook, signing, credential, URL, remote, user or Carter keys."},
    {"id": "plumbing", "class": "Plumbing", "group": "g2", "applies_from": "1", "items": ["commit-tree", "fast-import", "filter-branch", "filter-repo", "replace", "update-ref"], "note": "`update-ref` is forbidden with a raw SHA.", "literals": ["git commit-tree", "git fast-import", "git filter-branch", "git filter-repo"], "rfc": "C.4.1 row 7", "hint": "Low-level history commands (`commit-tree`, `update-ref`, `filter-branch`, ...) are not available to agents."},
    {"id": "other-verbs", "class": "Other verbs", "group": "g2", "applies_from": "2a", "items": ["sudo", "docker", "podman", "systemd-run", "crontab", "at", "opencode run", "opencode serve", "gh api"], "note": "`docker` and `podman` belong to consent group `sudo-docker`; `gh` is limited to the read allowlist and a leading `gh -R` is refused.", "literals": [], "rfc": "C.4.1 row 8", "hint": "This command is not available to agents (privilege, scheduling, nested OpenCode or the GitHub API). Ask the human.", "item_groups": {"sudo": "sudo-docker", "docker": "sudo-docker", "podman": "sudo-docker"}},
    {"id": "human-only-carter", "class": "Human-only Carter verbs", "group": "g2", "applies_from": "1G", "items": ["carter push", "carter pr", "carter identity add/remove/unlock/lock", "carter guard *", "carter github-token set", "carter broker *"], "literals": [], "rfc": "C.4.1 row 9", "hint": "That Carter command is human-only. Ask the human to run it in their own terminal."},
    {"id": "credential-paths", "class": "Credential paths", "group": "read-edit-denies", "applies_from": "2a", "ref": "credential_paths", "items": ["security find-generic-password", "security find-internet-password"], "note": "Any token that references `credential_paths` after normalization.", "literals": [], "rfc": "C.4.1 row 10", "hint": "Credential locations are off limits from the shell; do not read them."},
    {"id": "control-files", "class": "Control files", "group": "config-edit", "applies_from": "2a", "ref": "control_paths", "items": ["tee", "sed -i", "cp", "mv", "rm", "ln", "chmod", "truncate"], "note": "Write-capable references to `control_paths`: redirections (`>`, `>>`) and these commands, or interpreter args naming them.", "literals": [], "rfc": "C.4.1 row 11", "hint": "Carter's own control files cannot be written from the shell."}
  ],
    "gh_notes": {"leading_repo_flag": "A leading `gh -R/--repo` matches no allow statement, so it fails closed; the gate (2a) rejects it with 'put -R after the subcommand'. No statement carries -R.", "api": "`gh api` is never allowed: it is covered by the `deny-gh` statement and no allow matches it.", "positional": "`gh repo view` and `gh search repos` take the repository or query positionally: write `gh repo view <owner>/<repo>` and `gh search repos <query>`, never `-R` (spike 4: `unknown shorthand flag: 'R'`). `gh pr`, `gh issue` and `gh run` verbs take `-R <owner>/<repo>` after the subcommand.", "dropped": "`gh status` is not allowlisted: with a fine-grained read-only token it fails with HTTP 403 `Resource not accessible by personal access token` (spike 4)."},
  "consent_groups": [
    {"id": "g2", "live": true, "rev": 2, "effect": "agents can't push or write to GitHub from their shell (gh is read-only); per-agent carter_push/carter_pr denies. The plugin and shell isolation arrive in a later release: for now these are literal denies only"},
    {"id": "hooks", "live": false, "rev": 1, "effect": "git hooks that guard agent commits and pushes (reserved: nothing to install yet)"},
    {"id": "sudo-docker", "live": true, "rev": 1, "effect": "agents can't run sudo/docker; Packer docker builds must be typed in your terminal"},
    {"id": "read-edit-denies", "live": true, "rev": 1, "effect": "agents can't read SSH keys, gh/git credentials or the read-only token, and can't edit ~/.ssh"},
    {"id": "config-edit", "live": true, "rev": 1, "effect": "agents can't edit OpenCode config, git hooks and config, or Carter's own config and control files"},
    {"id": "alias", "live": false, "rev": 1, "effect": "optional git ai-commit alias (reserved: nothing to install yet)"},
    {"id": "repo_hooks", "live": false, "rev": 1, "effect": "per-repo guard hooks for git older than 2.54 (reserved: nothing to install yet)"}
  ],
  "agent_permission_denies": ["carter_push", "carter_pr"],
  "agent_permission_exempt": ["devops"],
  "agent_mcp_denies": {"action": "carter_github_*", "roles": ["learner"], "note": "C14: the Carter GitHub MCP server (carter-github, tools carter_github_*) is hidden from roles that do not need it. The role list is a product decision to confirm."},
  "gh_read_allowlist": [
    {"verb": "pr view", "pattern": "gh pr view *", "rfc": "4.5 gh read allowlist"},
    {"verb": "pr list", "pattern": "gh pr list *", "rfc": "4.5 gh read allowlist"},
    {"verb": "pr diff", "pattern": "gh pr diff *", "rfc": "4.5 gh read allowlist"},
    {"verb": "pr checks", "pattern": "gh pr checks *", "rfc": "4.5 gh read allowlist"},
    {"verb": "issue view", "pattern": "gh issue view *", "rfc": "4.5 gh read allowlist"},
    {"verb": "issue list", "pattern": "gh issue list *", "rfc": "4.5 gh read allowlist"},
    {"verb": "run view", "pattern": "gh run view *", "rfc": "4.5 gh read allowlist"},
    {"verb": "run list", "pattern": "gh run list *", "rfc": "4.5 gh read allowlist"},
    {"verb": "repo view", "pattern": "gh repo view *", "rfc": "4.5 gh read allowlist"},
    {"verb": "search", "pattern": "gh search *", "rfc": "4.5 gh read allowlist"}
  ],
  "policy_set": [
    {"id": "deny-git-push", "group": "g2", "action": "tool.use", "resource": "shell:git push *", "effect": "deny", "rfc": "4.5 first bullet"},
    {"id": "deny-git-send-pack", "group": "g2", "action": "tool.use", "resource": "shell:git send-pack *", "effect": "deny", "rfc": "4.5 first bullet"},
    {"id": "deny-gh", "group": "g2", "action": "tool.use", "resource": "shell:gh *", "effect": "deny", "rfc": "4.5 gh deny-by-default; the read allowlist lifts it"},
    {"id": "deny-sudo", "group": "sudo-docker", "action": "tool.use", "resource": "shell:sudo *", "effect": "deny", "rfc": "4.5 first bullet"},
    {"id": "deny-docker", "group": "sudo-docker", "action": "tool.use", "resource": "shell:docker *", "effect": "deny", "rfc": "4.5 first bullet"},
    {"id": "deny-read-ssh", "group": "read-edit-denies", "action": "tool.use", "resource": "read:*/.ssh/*", "effect": "deny", "rfc": "4.5 read denies"},
    {"id": "deny-read-gh-config", "group": "read-edit-denies", "action": "tool.use", "resource": "read:*/.config/gh/*", "effect": "deny", "rfc": "4.5 read denies"},
    {"id": "deny-read-opencode-service", "group": "read-edit-denies", "action": "tool.use", "resource": "read:*/opencode/service.json", "effect": "deny", "rfc": "4.5 read denies"},
    {"id": "deny-read-git-credentials", "group": "read-edit-denies", "action": "tool.use", "resource": "read:*/.git-credentials", "effect": "deny", "rfc": "4.5 read denies"},
    {"id": "deny-read-carter-secrets", "group": "read-edit-denies", "action": "tool.use", "resource": "read:*/.carter/secrets/*", "effect": "deny", "rfc": "4.5 read denies (the PAT file); C.1 credential_paths"},
    {"id": "deny-edit-ssh", "group": "read-edit-denies", "action": "tool.use", "resource": "edit:*/.ssh/*", "effect": "deny", "rfc": "4.5 edit denies (~/.ssh)"},
    {"id": "deny-edit-opencode-global", "group": "config-edit", "action": "tool.use", "resource": "edit:<home>/.config/opencode/opencode.json*", "effect": "deny", "rfc": "4.5 edit denies (global opencode config; the glob also covers .jsonc and Carter's backups)"},
    {"id": "deny-edit-opencode-project-json", "group": "config-edit", "action": "tool.use", "resource": "edit:*opencode.json", "effect": "deny", "rfc": "4.5 edit denies, D48 (project opencode.json; no leading slash so a Location-relative path matches too)"},
    {"id": "deny-edit-opencode-project-jsonc", "group": "config-edit", "action": "tool.use", "resource": "edit:*opencode.jsonc", "effect": "deny", "rfc": "4.5 edit denies, D48"},
    {"id": "deny-edit-opencode-dir", "group": "config-edit", "action": "tool.use", "resource": "edit:*.opencode/*", "effect": "deny", "rfc": "4.5 edit denies, D48 (.opencode/**)"},
    {"id": "deny-edit-git-hooks", "group": "config-edit", "action": "tool.use", "resource": "edit:*.git/hooks/*", "effect": "deny", "rfc": "4.5 edit denies (.git/hooks)"},
    {"id": "deny-edit-git-config", "group": "config-edit", "action": "tool.use", "resource": "edit:*.git/config", "effect": "deny", "rfc": "4.5 edit denies (.git/config)"},
    {"id": "deny-edit-gitconfig", "group": "config-edit", "action": "tool.use", "resource": "edit:<home>/.gitconfig", "effect": "deny", "rfc": "4.5 edit denies (~/.gitconfig)"},
    {"id": "deny-edit-git-xdg", "group": "config-edit", "action": "tool.use", "resource": "edit:<home>/.config/git/*", "effect": "deny", "rfc": "4.5 edit denies (~/.config/git)"},
    {"id": "deny-edit-carter-config", "group": "config-edit", "action": "tool.use", "resource": "edit:<home>/.carter/config.toml", "effect": "deny", "rfc": "4.5 edit denies (config.toml); C.1 control_paths"},
    {"id": "deny-edit-carter-bin", "group": "config-edit", "action": "tool.use", "resource": "edit:<home>/.carter/bin/*", "effect": "deny", "rfc": "4.5 control plane; C.1 control_paths"},
    {"id": "deny-edit-carter-hooks", "group": "config-edit", "action": "tool.use", "resource": "edit:<home>/.carter/hooks/*", "effect": "deny", "rfc": "4.5 control plane; C.1 control_paths"},
    {"id": "deny-edit-carter-run", "group": "config-edit", "action": "tool.use", "resource": "edit:<home>/.carter/run/*", "effect": "deny", "rfc": "4.5 control plane; C.1 control_paths"},
    {"id": "deny-edit-carter-secrets", "group": "config-edit", "action": "tool.use", "resource": "edit:<home>/.carter/secrets/*", "effect": "deny", "rfc": "4.5 control plane"},
    {"id": "deny-edit-carter-audit", "group": "config-edit", "action": "tool.use", "resource": "edit:<home>/.carter/state/audit/*", "effect": "deny", "rfc": "4.5 control plane (state/audit)"},
    {"id": "deny-edit-carter-isolation", "group": "config-edit", "action": "tool.use", "resource": "edit:<home>/.carter/isolation.json", "effect": "deny", "rfc": "4.5 control plane; C.1 control_paths"},
    {"id": "deny-edit-carter-gitconfig", "group": "config-edit", "action": "tool.use", "resource": "edit:<home>/.carter/gitconfig*", "effect": "deny", "rfc": "4.5 control plane, D61 (the file and its gitconfig.d fragments)"},
    {"id": "deny-edit-carter-guard-state", "group": "config-edit", "action": "tool.use", "resource": "edit:<home>/.carter/guard-state.json", "effect": "deny", "rfc": "4.5 control plane; C.1 control_paths"},
    {"id": "deny-edit-plugin", "group": "config-edit", "action": "tool.use", "resource": "edit:<home>/.config/opencode/plugins/*", "effect": "deny", "rfc": "4.5 control plane (the plugin dir). Placeholder path: slice 2a fixes where the plugin lives; the id stays"}
  ],
  "gate_rules": [
    {"id": "dynamic-command", "rfc": "C.4.2 rule 5", "hint": "A gated command name comes from a variable, substitution or `eval`; write the command out literally."},
    {"id": "interpreter-git", "rfc": "C.4.2 rules 2 and 5", "hint": "Do not run git or gh from an interpreter script (`python -c`, `sh -c`, ...); run the command directly."},
    {"id": "git-alias", "rfc": "C.4.2 rule 7", "hint": "This git alias cannot be resolved safely (shell alias, cycle, too deep or unknown directory); use the real subcommand."},
    {"id": "gate-input", "rfc": "G6", "hint": "The command is empty, over 1 MiB, contains NUL bytes or is not valid UTF-8 text."}
  ],
  "plugin": {"gate_args": ["-I", "-m", "carter.gate", "--json"], "env_args": ["-I", "-m", "carter.identity.env", "--json"], "pat_prefix": "github_pat_", "gh_token_dummy": "carter-no-read-token", "self_test_ms": 2000, "gate_timeout_ms": 1000, "env_timeout_ms": 2000, "status_dir": "run/plugin-status"},
  "credential_paths": ["/.ssh/", "/.config/gh/", "opencode/service.json", "/.git-credentials", "/proc/*/environ", "/Library/Keychains/", "/.carter/secrets/"],
  "control_paths": ["~/.carter/bin/", "~/.carter/hooks/", "~/.carter/run/", "~/.carter/isolation.json", "~/.carter/gitconfig", "~/.carter/config.toml", "~/.carter/guard-state.json", "<plugin dir>"]
}
