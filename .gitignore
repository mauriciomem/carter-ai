# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# Build artifact: the wheel's force-include (pyproject [tool.hatch.build.targets.wheel])
# maps the top-level agents/skills/templates/... into carter/_data/ AT BUILD TIME, and a
# dev editable-install populates it locally. It must NOT be tracked — a committed
# carter/_data/ shadows the force-include (wheel-build path collision) AND makes
# resources.py resolve to a half-populated dir on a clean checkout (the
# editable-install gotcha).
/carter/_data/

# Virtual environments
.venv/
venv/

# Tool caches / test + coverage output
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Live-eval metrics output (EVAL_METRICS_OUT in evals-live.yml)
eval-metrics.json

# IDE
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment variables (never commit real credentials)
.env

# Project scratch / pre-build notes (kept on disk, out of git)
/notes/

# Private Carter workspace state (versioned in its own nested .carter/.git)
/.carter/

# Architecture decision records are maintainer-local in this repo (not versioned)
/docs/adr/
