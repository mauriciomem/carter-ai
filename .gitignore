# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# Build artifact: the wheel's force-include (pyproject [tool.hatch.build.targets.wheel])
# maps the top-level agents/skills/templates/... into carter/_data/ AT BUILD TIME, and a
# dev editable-install populates it locally. It must NOT be tracked — a committed
# carter/_data/ shadows the force-include (wheel-build path collision) AND makes
# resources.py resolve to a half-populated dir on a clean checkout (ADR-0006 / the
# editable-install gotcha).
/carter/_data/

# Virtual environments
.venv/
venv/

# pytest
.pytest_cache/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment variables (never commit real credentials)
.env

# Installer backups and manifests are user-local, not repo content

# yui-soul workspace overlay (scaffolded into this repo root, not part of carter-ai).
# Root-anchored so carter's own knowledge/, docs/, and .github/workflows/ are unaffected.
/.yui.json
/AGENTS.md
/PORTABILITY.md
/.github/agents/
/.github/instructions/
/.knowledge/
/.plans/
/.rfcs/
/.ideas/
/.backlog/

# External reference repos (vendored for inspection, not carter-ai source)
/external/

# Project scratch / pre-build notes (kept on disk, out of git)
/notes/

# Private Carter workspace state (versioned in its own nested .carter/.git)
/.carter/
