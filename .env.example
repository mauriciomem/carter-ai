# Carter — Required Environment Variables
#
# Copy this file and set values in your shell profile (~/.zshrc, ~/.bashrc, etc.)
# Example: export GITHUB_TOKEN="ghp_your_token_here"

# ─── GitHub MCP Server (carter-github) ───
GITHUB_TOKEN=          # GitHub personal access token (required)

# ─── Terraform / HCP MCP Server (carter-terraform) ───
TF_TOKEN=              # HCP Terraform API token (required)

# ─── Atlassian MCP Server (carter-atlassian) ───
ATLASSIAN_API_TOKEN=   # Atlassian API token (required)
ATLASSIAN_EMAIL=       # Atlassian account email (required)
ATLASSIAN_URL=         # Atlassian instance URL, e.g. https://your-domain.atlassian.net (required)
