# Carter — Environment Variables
#
# Set these in your shell profile (~/.zshrc, ~/.bashrc, etc.) — never commit real values.
# Example: export GITHUB_TOKEN="ghp_your_token_here"
# Every variable is optional; set only those for the features you use.

# ─── GitHub MCP Server (carter-github) — also reported by `carter ops config` ───
GITHUB_TOKEN=          # GitHub personal access token (needed for carter-github)

# ─── Terraform / HCP MCP Server (carter-terraform, Docker image) ───
TFE_TOKEN=             # HCP Terraform / Terraform Enterprise API token (needed for carter-terraform)
TFE_ADDRESS=           # Optional: TFE address; leave unset for HCP Terraform (app.terraform.io)

# ─── Atlassian MCP Server (carter-atlassian) ───
# Official remote server (https://mcp.atlassian.com/v2/mcp) — authenticates via OAuth
# in your client on first use. No env vars needed.

# ─── Output ───
# NO_COLOR=1           # Optional: disable colored installer output

# ─── Contributors only: live evals (uv run pytest evals/ -m live) ───
# Not needed to use Carter. The live evals read one of these (Anthropic first) and
# skip cleanly when neither is set. Never commit a real key.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
