{
  "carter-github": {
    "type": "local",
    "command": [
      "docker",
      "run",
      "-i",
      "--rm",
      "-e",
      "GITHUB_PERSONAL_ACCESS_TOKEN",
      "ghcr.io/github/github-mcp-server@sha256:250bc6ce70788207608ef74cef4397230ff2e8481218da74d6093e4bd9101132",
      "stdio",
      "--read-only",
      "--tools",
      "get_me,get_file_contents,search_code,search_repositories,list_commits,get_commit,pull_request_read,issue_read,list_issues,list_pull_requests"
    ],
    "environment": {
      "GITHUB_PERSONAL_ACCESS_TOKEN": "{file:~/.carter/secrets/gh-read.token}"
    }
  }
}
